# ── PostgreSQL (pgvector) ──────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ragdb
DB_USER=raguser
DB_PASSWORD=ragpass

# ── Ollama ────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=bge-m3
LLM_MODEL=qwen2.5
# bge-m3 임베딩 차원 (모델 변경 시 init.sql 의 vector(N) 도 함께 변경)
EMBED_DIM=1024

# ── 청킹 / 검색 ────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
